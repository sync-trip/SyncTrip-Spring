
# Copy this file to .env for local development or CI secrets for deployment.
# Fill sensitive values (API keys, DB passwords, JWT secret) from your secret store.

# -------------------------
# MySQL / Docker Compose
# -------------------------
# MySQL initial database and account used by the compose mysql service
MYSQL_DATABASE=synctripdb
MYSQL_USER=synctrip_user
MYSQL_PASSWORD=changeme_mysql_password
MYSQL_ROOT_PASSWORD=changeme_root_password

# Optional: container and host port customization
MYSQL_CONTAINER_NAME=synctrip-mysql
MYSQL_HOST_PORT=3306

# -------------------------
# Application / App service
# -------------------------
# Image / container naming (compose override)
APP_IMAGE_NAME=synctrip-backend
IMAGE_TAG=latest
APP_CONTAINER_NAME=synctrip-backend

# Spring profile to activate in the app container (local/dev/prod)
#SPRING_PROFILES_ACTIVE=local

# When running in Docker Compose the app service sets DB_URL automatically.
# For non-compose runs you can override DB connection here (JDBC URL)
DB_URL=jdbc:mysql://mysql:3306/synctripdb?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=${MYSQL_USER}
DB_PASSWORD=${MYSQL_PASSWORD}

JAVA_OPTS=

# Host port mapping for the app container
APP_HOST_PORT=8080

# -------------------------
# OAuth / Third-party APIs
# -------------------------
# Kakao OAuth (used for login)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Single callback used by the app; choose appropriate value per environment
KAKAO_REDIRECT_URI=
KAKAO_AUTHORIZATION_URI=https://kauth.kakao.com/oauth/authorize
KAKAO_TOKEN_URI=https://kauth.kakao.com/oauth/token
KAKAO_USER_INFO_URI=https://kapi.kakao.com/v2/user/me
KAKAO_LOCAL_SEARCH_URI=https://dapi.kakao.com/v2/local/search/category.json
KAKAO_SCOPE=account_email,profile_nickname,profile_image

# Google OAuth (used for login)
# 구글 클라우드 콘솔에서 "웹 애플리케이션"으로 생성한 클라이언트 ID만 필요합니다.
# 형식: xxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID=

# Google Maps / Places
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com

# ExchangeRate-API (다통화 환율, USR-021)
# 발급: https://www.exchangerate-api.com (무료 월 1,500회)
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_BASE_URL=https://v6.exchangerate-api.com

# Gemini Vision API (영수증 OCR, USR-019)
# Google AI Studio에서 발급: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-3.5-flash

# Firebase Cloud Messaging (FCM, 푸시 알림)
# 1. Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성
# 2. 다운로드한 JSON을 base64로 인코딩: base64 -w 0 firebase-service-account.json
# 3. 인코딩 결과를 아래에 붙여넣기
FIREBASE_CREDENTIALS_JSON=

# -------------------------
# App behavior / security
# -------------------------
# Enable stricter security in prod. Default false for local dev.
APP_SECURITY_ENABLED=false

# Invite link base urls (deep link + share link)
APP_INVITE_SHARE_BASE_URL=https://test.sync-trip.app/invite?code=
APP_INVITE_DEEP_LINK_BASE_URL=synctrip://band/join?code=

# CORS origins allowed (comma separated). Use * only for local testing.
CORS_ALLOWED_ORIGINS=*

# -------------------------
# JWT / Auth settings
# -------------------------
# JWT signing secret (must be >=32 characters in production)
JWT_SECRET=change-me-at-least-32-chars-long-please
JWT_ISSUER=synctrip
JWT_ACCESS_TOKEN_TTL_SECONDS=900        # 15 minutes
JWT_REFRESH_TOKEN_TTL_SECONDS=1209600   # 14 days

# -------------------------
# Other optional runtime hints
# -------------------------
# Number of seconds for token TTLs, feature flags, etc. can be overridden here.
