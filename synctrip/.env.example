# Copy this file to .env for your local machine
MYSQL_DATABASE=synctripdb
MYSQL_USER=syncuser
MYSQL_PASSWORD=syncpass
MYSQL_ROOT_PASSWORD=rootpass

# For compose.prod.yml (app service)
APP_IMAGE=synctrip-backend:latest
DB_URL=jdbc:mysql://mysql:3306/synctripdb?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=syncuser
DB_PASSWORD=syncpass
JAVA_OPTS=


